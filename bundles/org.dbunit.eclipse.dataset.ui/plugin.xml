<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="org.dbunit.eclipse.dataset.ui.preferences.DatasetPreferenceInitializer"/>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <editor
            id="org.dbunit.eclipse.dataset.ui.flatXmlDatasetEditor"
            name="%editor.name"
            icon="icons/obj16/dataset.png"
            class="org.dbunit.eclipse.dataset.ui.editor.FlatXmlDatasetEditor"
            contributorClass="org.dbunit.eclipse.dataset.ui.editor.DatasetEditorContributor"
            default="true">
         <contentTypeBinding contentTypeId="org.dbunit.eclipse.dataset.flatxml"/>
      </editor>
   </extension>

   <extension point="org.eclipse.ui.contexts">
      <context
            id="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            name="%context.tablesPage.name"
            description="%context.tablesPage.description"
            parentId="org.eclipse.ui.contexts.window"/>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <category
            id="org.dbunit.eclipse.dataset.ui.category"
            name="%command.category.name"/>
      <command id="org.dbunit.eclipse.dataset.ui.insertRowAbove" name="%command.insertRowAbove.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.insertRowBelow" name="%command.insertRowBelow.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.deleteRows" name="%command.deleteRows.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.duplicateRows" name="%command.duplicateRows.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.moveRowsUp" name="%command.moveRowsUp.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.moveRowsDown" name="%command.moveRowsDown.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.addColumn" name="%command.addColumn.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.renameColumn" name="%command.renameColumn.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.deleteColumn" name="%command.deleteColumn.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.addTable" name="%command.addTable.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.renameTable" name="%command.renameTable.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.deleteTable" name="%command.deleteTable.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.setNull" name="%command.setNull.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.setEmptyString" name="%command.setEmptyString.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.fillDown" name="%command.fillDown.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.editCellInDialog" name="%command.editCellInDialog.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
      <command id="org.dbunit.eclipse.dataset.ui.showInSource" name="%command.showInSource.name"
            categoryId="org.dbunit.eclipse.dataset.ui.category"/>
   </extension>
   <extension point="org.eclipse.ui.bindings">
      <key sequence="M1+M2+ENTER" commandId="org.dbunit.eclipse.dataset.ui.insertRowAbove"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key sequence="M1+ENTER" commandId="org.dbunit.eclipse.dataset.ui.insertRowBelow"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key sequence="M1+DEL" commandId="org.dbunit.eclipse.dataset.ui.deleteRows"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key sequence="M1+M3+ARROW_DOWN" commandId="org.dbunit.eclipse.dataset.ui.duplicateRows"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key sequence="M3+ARROW_UP" commandId="org.dbunit.eclipse.dataset.ui.moveRowsUp"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key sequence="M3+ARROW_DOWN" commandId="org.dbunit.eclipse.dataset.ui.moveRowsDown"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key sequence="M1+D" commandId="org.dbunit.eclipse.dataset.ui.fillDown"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key sequence="M2+F2" commandId="org.dbunit.eclipse.dataset.ui.editCellInDialog"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key sequence="F3" commandId="org.dbunit.eclipse.dataset.ui.showInSource"
            contextId="org.dbunit.eclipse.dataset.ui.tablesPageContext"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>

   <extension point="org.eclipse.ui.themes">
      <themeElementCategory
            id="org.dbunit.eclipse.dataset.ui.themeCategory"
            label="%theme.category.label"/>
      <colorDefinition id="org.dbunit.eclipse.dataset.ui.source.tagColor" label="%theme.tagColor.label"
            categoryId="org.dbunit.eclipse.dataset.ui.themeCategory" value="63,127,127">
         <description>%theme.tagColor.description</description>
      </colorDefinition>
      <colorDefinition id="org.dbunit.eclipse.dataset.ui.source.attributeNameColor"
            label="%theme.attributeNameColor.label"
            categoryId="org.dbunit.eclipse.dataset.ui.themeCategory" value="127,0,127">
         <description>%theme.attributeNameColor.description</description>
      </colorDefinition>
      <colorDefinition id="org.dbunit.eclipse.dataset.ui.source.attributeValueColor"
            label="%theme.attributeValueColor.label"
            categoryId="org.dbunit.eclipse.dataset.ui.themeCategory" value="42,0,255">
         <description>%theme.attributeValueColor.description</description>
      </colorDefinition>
      <colorDefinition id="org.dbunit.eclipse.dataset.ui.source.commentColor" label="%theme.commentColor.label"
            categoryId="org.dbunit.eclipse.dataset.ui.themeCategory" value="63,95,191">
         <description>%theme.commentColor.description</description>
      </colorDefinition>
      <colorDefinition id="org.dbunit.eclipse.dataset.ui.source.declarationColor"
            label="%theme.declarationColor.label"
            categoryId="org.dbunit.eclipse.dataset.ui.themeCategory" value="128,128,128">
         <description>%theme.declarationColor.description</description>
      </colorDefinition>
   </extension>
   <extension point="org.eclipse.e4.ui.css.swt.theme">
      <stylesheet uri="css/e4-dark_dbunit_dataset.css">
         <themeid refid="org.eclipse.e4.ui.css.theme.e4_dark"/>
      </stylesheet>
   </extension>
   <extension point="org.eclipse.core.filebuffers.documentSetup">
      <participant
            class="org.dbunit.eclipse.dataset.ui.source.XmlDocumentSetupParticipant"
            contentTypeId="org.dbunit.eclipse.dataset.flatxml"/>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="org.dbunit.eclipse.dataset.ui.preferencePage"
            name="%preferencePage.name"
            class="org.dbunit.eclipse.dataset.ui.preferences.DatasetPreferencePage"/>
   </extension>
</plugin>
