<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.dbunit</groupId>
    <artifactId>dbunit-eclipse-plugin</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>org.dbunit.eclipse.feature</artifactId>
  <packaging>eclipse-feature</packaging>

  <name>dbUnit Eclipse Plugin - Feature</name>
  <description>
    The installable unit users select on the update site; also generates the matching source feature.
  </description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-source-plugin</artifactId>
        <executions>
          <execution>
            <id>feature-source</id>
            <goals>
              <goal>feature-source</goal>
            </goals>
            <configuration>
              <!-- The source feature covers only this project's bundles. -->
              <excludes>
                <feature id="org.eclipse.nebula.widgets.nattable.core.feature"/>
                <plugin id="org.eclipse.collections"/>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Must follow feature-source so the generated source feature gets p2 metadata too. -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-p2-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-p2-metadata</id>
            <phase>package</phase>
            <goals>
              <goal>p2-metadata</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
