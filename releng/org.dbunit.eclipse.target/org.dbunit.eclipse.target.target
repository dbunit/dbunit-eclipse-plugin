<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<!--
  Baseline target platform: the OLDEST Eclipse release the plugin supports (2024-06, Java 17).
  Compiling against the oldest release keeps the plugin installable on every release from it onward.
  Raising the baseline is a deliberate decision: update the release repository URL, feature.properties
  (supported releases text), README.adoc, and the Eclipse Marketplace listing together.

  NatTable and Eclipse Collections have fixed versions, identical in latest.target, so only the Eclipse
  platform differs between the two targets. Eclipse Collections is Orbit's single OSGi bundle (API and
  implementation together) from the 2024-06 release repository: the split Maven Central bundles fail in
  OSGi, because the API bundle finds the implementation with java.util.ServiceLoader.
-->
<target name="dbUnit Eclipse Plugin - Baseline (Eclipse 2024-06)" sequenceNumber="2">
  <locations>
    <location followRepositoryReferences="false" includeAllPlatforms="false" includeConfigurePhase="false" includeMode="planner" includeSource="true" type="InstallableUnit">
      <repository location="https://download.eclipse.org/releases/2024-06/"/>
      <repository location="https://download.eclipse.org/nattable/releases/2.7.0/repository/"/>
      <unit id="org.eclipse.platform.feature.group" version="0.0.0"/>
      <unit id="org.eclipse.nebula.widgets.nattable.core.feature.feature.group" version="2.7.0.202608310502"/>
      <unit id="org.eclipse.collections" version="11.1.0.v20220705-1455"/>
    </location>
  </locations>
  <targetJRE path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17"/>
</target>
